@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<form class="userForm"
      method="post"
      asp-controller="Home"
      asp-action="Login">

    <label for="username">Username</label>

    <input type="text"
           id="username"
           name="Username"
           required />

    <label for="password">Password</label>

    <input type="password"
           id="password"
           name="Password"
           required />

    <button type="submit">
        Login
    </button>

</form>